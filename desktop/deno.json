{
  "tasks": {
    "dev": "DESKTOP_PORT=8080 deno run --watch --env-file=../.env --allow-net --allow-env=API_BASE_URL,TIMED_ACCESS_API_KEY,DESKTOP_PORT main.ts",
    "dev:window": "deno desktop --hmr --env-file=../.env --allow-net --allow-env=API_BASE_URL,TIMED_ACCESS_API_KEY,DESKTOP_PORT main.ts",
    "icon": "deno run --allow-write=icon.png scripts/generate_icon.ts",
    "build": "deno desktop --output TimedAccess.app --icon icon.png --env-file=../.env --allow-net --allow-env=API_BASE_URL,TIMED_ACCESS_API_KEY,DESKTOP_PORT main.ts",
    "build:prod": "deno desktop --output TimedAccess.app --icon icon.png --env-file=../.env.production --allow-net --allow-env=API_BASE_URL,TIMED_ACCESS_API_KEY,DESKTOP_PORT main.ts"
  }
}
